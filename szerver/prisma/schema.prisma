generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
   url      = env("DATABASE_URL")
}

model Felhasznalo {
  id            Int        @id @default(autoincrement())
  nev           String
  email         String     @unique
  jelszoHash    String
  szerepkor     String     @default("FELHASZNALO")
  foglalasok    Foglalas[]
  letrehozva    DateTime   @default(now())
}

model Film {
  id          Int        @id @default(autoincrement())
  cim         String
  leiras      String
  hosszPerc   Int
  kepUrl      String?
  vetitesek   Vetites[]
  letrehozva  DateTime   @default(now())
}

model Vetites {
  id              Int        @id @default(autoincrement())
  filmId          Int
  film            Film       @relation(fields: [filmId], references: [id])
  kezdesIdopont   DateTime
  terem           String
  osszesHely      Int
  foglalasok      Foglalas[]
  letrehozva      DateTime   @default(now())
}

model Foglalas {
  id              Int          @id @default(autoincrement())
  felhasznaloId   Int
  vetitesId        Int
  helyekSzama      Int
  felhasznalo      Felhasznalo @relation(fields: [felhasznaloId], references: [id])
  vetites          Vetites     @relation(fields: [vetitesId], references: [id])
  letrehozva       DateTime    @default(now())
}